{
  "compilerOptions": {
    "target": "es2021",
    "lib": ["es2021"],
    "strict": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "hono": ["./node_modules/hono"],
      "hono/cookie": ["./node_modules/hono/dist/types/helper/cookie"]
    },
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types", "vitest/globals"],
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true
  },
  "include": ["src/**/*", "../../packages/auth-client/**/*"],
  "exclude": ["node_modules"]
}
