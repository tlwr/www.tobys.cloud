{
  "name": "www.toby.codes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "toby.codes personal site on Cloudflare Workers",
  "scripts": {
    "generate-posts": "node tools/generate-posts.mjs",
    "predev": "npm run generate-posts && npm run ensure-dev-vars",
    "predeploy": "npm run generate-posts",
    "pretypecheck": "npm run generate-posts",
    "pretest": "npm run generate-posts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed-local": "node tools/seed-local.mjs",
    "seed-remote": "node tools/seed-remote.mjs",
    "check-remote": "node tools/check-remote.mjs",
    "set-session-secret": "node tools/set-session-secret.mjs",
    "ensure-dev-vars": "node tools/ensure-dev-vars.mjs",
    "push-posts": "node tools/push-posts.mjs",
    "pull-posts": "node tools/pull-posts.mjs"
  },

  "dependencies": {
    "bcryptjs": "^2.4.3",
    "hono": "^4.11.10",
    "marked": "^17.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@types/bcryptjs": "^2.4.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "wrangler": "^4.66.0"
  }
}

