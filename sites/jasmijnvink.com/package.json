{
  "name": "jasmijnvink.com",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "jasmijnvink.com on Cloudflare Workers",
  "scripts": {
    "predev": "npm run ensure-dev-vars",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "set-auth-jwt-secret": "node tools/set-auth-jwt-secret.mjs",
    "ensure-dev-vars": "node tools/ensure-dev-vars.mjs",
    "import-from-rails": "node tools/import-from-rails.mjs"
  },
  "dependencies": {
    "@tobys/auth-client": "file:../../packages/auth-client",
    "hono": "^4.11.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "wrangler": "^4.66.0"
  }
}
