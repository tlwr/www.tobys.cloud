{
  "name": "jasmijnvink.com",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "jasmijnvink.com on Cloudflare Workers",
  "scripts": {
    "predev": "npm run ensure-dev-vars",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed-local": "node tools/seed-local.mjs",
    "seed-remote": "node tools/seed-remote.mjs",
    "set-session-secret": "node tools/set-session-secret.mjs",
