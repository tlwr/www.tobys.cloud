    "import-from-rails": "node tools/import-from-rails.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "hono": "^4.11.10",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@types/bcryptjs": "^2.4.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "wrangler": "^4.66.0"
  }
