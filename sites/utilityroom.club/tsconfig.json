{
  "compilerOptions": {
    "target": "es2021",
    "lib": ["es2021"],
    "allowJs": true,
    "checkJs": false,
    "outDir": "./dist",
    "strict": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "hono": ["./node_modules/hono"],
      "hono/cookie": ["./node_modules/hono/dist/types/helper/cookie"]
    },
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "incremental": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types"],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*", "../../packages/auth-client/**/*"],
  "exclude": ["node_modules"]
}
